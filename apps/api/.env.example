# LifeForge Production Environment Configuration Example
# Tagline: Turn goals into verified actions

APP_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-key-32bytes-min
DEBUG=true
PORT=8000

# PostgreSQL Database (Async and Sync URLs)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lifeforge
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/lifeforge

# Redis Cache & Background Worker
REDIS_URL=redis://localhost:6379/0

# Gemini 3-Family AI Models
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_REASONING_MODEL=gemini-3.1-pro-preview
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_LIGHT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Weaviate Cloud Vector Database
WEAVIATE_URL=https://your-weaviate-cluster.weaviate.network
WEAVIATE_API_KEY=your_weaviate_api_key_here

# LangSmith Observability & Tracing
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=lifeforge-production
LANGSMITH_TRACING=true

# Google Workspace OAuth & Integrations
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8001/api/v1/integrations/google/callback

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
