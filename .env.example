# ==============================================================================
# LifeForge - Environment Configuration Template
# Turn goals into verified actions.
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
PORT=8000
SECRET_KEY=lifeforge-super-secret-production-key-change-in-prod-2026-xyz
JWT_SECRET=lifeforge-jwt-secret-key-32bytes-long-super-safe
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL 16)
# For local zero-setup testing, SQLite fallback is enabled if DATABASE_URL starts with sqlite
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lifeforge
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/lifeforge

# Redis Configuration (Cache, Celery/Queue & SSE PubSub)
REDIS_URL=redis://localhost:6379/0

# Gemini 3 Family AI Models Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_REASONING_MODEL=gemini-3.1-pro-preview
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_LITE_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Weaviate Cloud Vector Database
WEAVIATE_URL=https://lifeforge-cluster-xyz.weaviate.network
WEAVIATE_API_KEY=your-weaviate-api-key-here
WEAVIATE_ENVIRONMENT=sandbox

# LangSmith Observability & Tracing
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=lifeforge-production
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# External Search Provider (Tavily / Serper / Mock)
SEARCH_API_KEY=your-search-api-key-here

# Google OAuth2 & Workspace Integrations (Gmail, Calendar, Drive)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback
ENABLE_GOOGLE_SIMULATION_SANDBOX=true

# AWS S3 / Document Storage (Optional for cloud storage)
AWS_ACCESS_KEY_ID=your-aws-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET=lifeforge-documents-storage

# Execution Guardrails
MAX_TOOL_CALLS_PER_RUN=25
AGENT_TIMEOUT_SECONDS=180
AUTO_APPROVE_SAFE_ACTIONS=false
ENABLE_DEV_MOCK_FALLBACK=true
